<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="tonyapps" translate="label" sortOrder="400">
            <label>Tonyapps</label>
        </tab>
        <section id="tonyapps_b2b" translate="label" type="text" sortOrder="20"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>B2B Company Account</label>
            <tab>tonyapps</tab>
            <resource>Tonyapps_B2b::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="0">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Enable B2B Company Accounts</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Turning this off leaves the data in place but hides company features from the storefront.</comment>
                </field>
            </group>

            <group id="registration" translate="label" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Storefront Registration</label>
                <field id="frontend_enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Allow Company Registration</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Companies registered on the storefront always start as Pending Approval and cannot use company pricing until an administrator approves them.</comment>
                </field>
                <field id="in_customer_registration" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Offer It During Customer Registration</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="frontend_enabled">1</field>
                    </depends>
                    <comment>Adds an optional company section to the Create an Account form.</comment>
                </field>
            </group>

            <group id="email" translate="label" type="text" sortOrder="30"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Emails</label>
                <field id="new_company_template" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>New Company Notification</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <comment>Sent to the store's General Contact when a company registers on the storefront.</comment>
                </field>
                <field id="approved_template" translate="label" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Company Approved</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                </field>
                <field id="rejected_template" translate="label" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Company Rejected</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                </field>
            </group>
        </section>

        <section id="payment">
            <group id="tonyapps_b2b_credit" translate="label" type="text" sortOrder="5"
                   showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Store Credit (B2B Companies)</label>
                <field id="active" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>payment/tonyapps_b2b_credit/active</config_path>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Title</label>
                    <config_path>payment/tonyapps_b2b_credit/title</config_path>
                </field>
                <field id="order_status" translate="label" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>New Order Status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status\NewStatus</source_model>
                    <config_path>payment/tonyapps_b2b_credit/order_status</config_path>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Sort Order</label>
                    <frontend_class>validate-number</frontend_class>
                    <config_path>payment/tonyapps_b2b_credit/sort_order</config_path>
                </field>
            </group>
        </section>
    </system>
</config>
