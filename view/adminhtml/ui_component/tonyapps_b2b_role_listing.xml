<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tonyapps_b2b_role_listing.tonyapps_b2b_role_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>tonyapps_b2b_role_columns</spinner>
        <deps>
            <dep>tonyapps_b2b_role_listing.tonyapps_b2b_role_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="tonyapps_b2b_role_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <!-- Keep the company scope on every reload (paging, sorting, filtering) of the grid. -->
            <filterUrlParams>
                <param name="company_id">*</param>
            </filterUrlParams>
            <storageConfig>
                <param name="indexField" xsi:type="string">role_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Tonyapps_B2b::companies</aclResource>
        <dataProvider name="tonyapps_b2b_role_listing_data_source"
                      class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
            <settings>
                <requestFieldName>role_id</requestFieldName>
                <primaryFieldName>role_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="tonyapps_b2b_role_columns">
        <column name="role_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="role_name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Role</label>
            </settings>
        </column>
        <column name="company_id" sortOrder="30">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Company ID</label>
            </settings>
        </column>
        <column name="is_default" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Default Role</label>
            </settings>
        </column>
        <column name="permissions" class="Tonyapps\B2b\Ui\Component\Listing\Column\RolePermissions" sortOrder="50">
            <settings>
                <label translate="true">Permissions</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <actionsColumn name="actions" class="Tonyapps\B2b\Ui\Component\Listing\Column\RoleActions" sortOrder="60">
            <settings>
                <indexField>role_id</indexField>
                <resizeEnabled>false</resizeEnabled>
            </settings>
        </actionsColumn>
    </columns>
</listing>
