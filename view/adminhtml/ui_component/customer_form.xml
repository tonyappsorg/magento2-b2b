<?xml version="1.0"?>
<!--
    Adds a Company fieldset to the admin customer form.
    Read by Tonyapps\B2b\Plugin\Customer\AddCompanyToForm, written by
    Tonyapps\B2b\Observer\SaveCustomerCompany (company membership is not a customer attribute, so
    the native save does not carry it).
-->
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="tonyapps_b2b" sortOrder="25">
        <settings>
            <label translate="true">Company</label>
            <dataScope>tonyapps_b2b</dataScope>
        </settings>
        <field name="company_id" formElement="select" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Company</label>
                <dataScope>company_id</dataScope>
                <notice translate="true">Assigning a company puts this customer in the company's customer group. Removing them puts them back in the default group.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Tonyapps\B2b\Model\Source\CustomerCompanyList"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
