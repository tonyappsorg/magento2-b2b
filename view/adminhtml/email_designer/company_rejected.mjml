        <mj-text font-size="12px" font-weight="600" letter-spacing="1px" text-transform="uppercase" color="#666666">{{trans "Company account"}}</mj-text>
        <mj-text font-size="24px" font-weight="600">{{trans "About your company account request"}}</mj-text>
        <mj-text>{{trans "Hi %name, we are unable to approve the company account request for %company at this time." name=$admin_name company=$company_name}}</mj-text>
        <mj-text><table width="100%" cellpadding="0" cellspacing="0" role="presentation"><tr><td style="padding:16px 20px;background:#f8f8f8;border-left:4px solid #cccccc;border-radius:2px;"><p style="margin:0;">{{trans "Your personal account is unaffected and you can continue to shop as usual."}}</p></td></tr></table></mj-text>
        <mj-divider border-width="1px" border-color="#e5e5e5"></mj-divider>
        <mj-text font-size="12px" color="#999999">{{trans "If you would like to discuss this, just reply to this email."}}</mj-text>
