        <mj-text font-size="12px" font-weight="600" letter-spacing="1px" text-transform="uppercase" color="#2e7d32">{{trans "Company account"}}</mj-text>
        <mj-text font-size="24px" font-weight="600">{{trans "Welcome aboard, %company!" company=$company_name}}</mj-text>
        <mj-text>{{trans "Hi %name, your company account has been approved. You and your colleagues can now shop as %company." name=$admin_name company=$company_name}}</mj-text>
        <mj-text><table width="100%" cellpadding="0" cellspacing="0" role="presentation"><tr><td style="padding:16px 20px;background:#f1f8f1;border-left:4px solid #2e7d32;border-radius:2px;"><p style="margin:0 0 8px;font-weight:600;">{{trans "What you can do now"}}</p><p style="margin:0 0 4px;">{{trans "• Invite colleagues and give them roles and permissions."}}</p><p style="margin:0 0 4px;">{{trans "• See every order placed by your company."}}</p><p style="margin:0;">{{trans "• Use your company's prices, payment methods and store credit at checkout."}}</p></td></tr></table></mj-text>
        <mj-button background-color="#1979c3" border-radius="3px" font-size="16px" font-weight="600" inner-padding="14px 32px" href="{{var company_url}}">{{trans "Go to your company dashboard"}}</mj-button>
        <mj-divider border-width="1px" border-color="#e5e5e5"></mj-divider>
        <mj-text font-size="12px" color="#999999">{{trans "Questions about your account? Just reply to this email."}}</mj-text>
