        <mj-text font-size="12px" font-weight="600" letter-spacing="1px" text-transform="uppercase" color="#f5a623">{{trans "New company registration"}}</mj-text>
        <mj-text font-size="24px" font-weight="600">{{trans "%company is waiting for approval" company=$company_name}}</mj-text>
        <mj-text>{{trans "A new company has registered on the storefront."}}</mj-text>
        <mj-raw ta-block="b2b_company_details"></mj-raw>
        <mj-button background-color="#1979c3" border-radius="3px" font-size="16px" font-weight="600" inner-padding="14px 32px" href="{{var admin_url}}">{{trans "Review this company"}}</mj-button>
        <mj-divider border-width="1px" border-color="#e5e5e5"></mj-divider>
        <mj-text font-size="12px" color="#999999">{{trans "Until it is approved, its users keep the default customer group and do not get company pricing."}}</mj-text>
