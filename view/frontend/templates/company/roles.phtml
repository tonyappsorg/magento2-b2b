<?php
/**
 * Company roles: the list, and one form that both adds and edits.
 *
 * @var \Tonyapps\B2b\Block\Company\Roles $block
 * @var \Magento\Framework\Escaper $escaper
 */
$roles = $block->getRoles();
$canManage = $block->canManage();
?>
<div class="block block-company-roles">
    <div class="block-content">
        <?php if ($roles): ?>
            <div class="table-wrapper card mb-4">
                <table class="data table table-company-roles w-full">
                    <caption class="sr-only"><?= $escaper->escapeHtml(__('Company Roles')) ?></caption>
                    <thead>
                        <tr>
                            <th scope="col" class="col name"><?= $escaper->escapeHtml(__('Role')) ?></th>
                            <th scope="col" class="col permissions"><?= $escaper->escapeHtml(__('Permissions')) ?></th>
                            <th scope="col" class="col users"><?= $escaper->escapeHtml(__('Users')) ?></th>
                            <?php if ($canManage): ?>
                                <th scope="col" class="col actions">&nbsp;</th>
                            <?php endif; ?>
                        </tr>
                    </thead>
                    <tbody>
                    <?php foreach ($roles as $role): ?>
                        <tr>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Role')) ?>" class="col name">
                                <?= $escaper->escapeHtml($role->getRoleName()) ?>
                                <?php if ($role->isDefault()): ?>
                                    <span class="role-default-badge">
                                        (<?= $escaper->escapeHtml(__('default')) ?>)
                                    </span>
                                <?php endif; ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Permissions')) ?>" class="col permissions">
                                <?= $escaper->escapeHtml($block->getPermissionLabels($role)) ?>
                            </td>
                            <td data-th="<?= $escaper->escapeHtmlAttr(__('Users')) ?>" class="col users">
                                <?= (int)$block->getMemberCount($role) ?>
                            </td>
                            <?php if ($canManage): ?>
                                <td class="col actions">
                                    <div class="flex items-center justify-end gap-2">
                                        <button type="button" class="action edit btn btn-secondary size-10 p-2"
                                                data-role-edit="<?= (int)$role->getId() ?>"
                                                aria-label="<?= $escaper->escapeHtmlAttr(__('Edit role %1', $role->getRoleName())) ?>"
                                                title="<?= $escaper->escapeHtmlAttr(__('Edit role %1', $role->getRoleName())) ?>">
                                            <svg data-icon="pencil" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M12 20h9"/>
                                                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/>
                                            </svg>
                                        </button>
                                        <?php /* Core's data-post widget asks for confirmation, then posts with the form key. */ ?>
                                        <button type="button" class="action delete btn btn-secondary size-10 p-2"
                                                aria-label="<?= $escaper->escapeHtmlAttr(__('Delete role %1', $role->getRoleName())) ?>"
                                                title="<?= $escaper->escapeHtmlAttr(__('Delete role %1', $role->getRoleName())) ?>"
                                                data-post="<?= $escaper->escapeHtmlAttr(json_encode([
                                            'action' => $block->getDeleteUrl($role),
                                            'data' => [
                                                'confirmation' => true,
                                                'confirmationMessage' => (string)__(
                                                    'Delete the role "%1"? Its members fall back to the company default role.',
                                                    $role->getRoleName()
                                                ),
                                            ],
                                        ])) ?>">
                                            <svg data-icon="trash" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M3 6h18"/>
                                                <path d="M8 6V4h8v2"/>
                                                <path d="M19 6l-1 14H6L5 6"/>
                                                <path d="M10 11v6"/>
                                                <path d="M14 11v6"/>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            <?php endif; ?>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php else: ?>
            <div class="message info empty"><span><?= $escaper->escapeHtml(
                __('Your company has no roles yet. Until one is marked as the default, members can only see the company page.')
            ) ?></span></div>
        <?php endif; ?>
    </div>

    <?php if ($canManage): ?>
        <form class="form form-company-role" id="company-role-form"
              action="<?= $escaper->escapeUrl($block->getSaveUrl()) ?>" method="post"
              data-mage-init='{"validation":{}}'>
            <?= $block->getBlockHtml('formkey') ?>
            <input type="hidden" name="role[role_id]" id="role_id" value="">

            <fieldset class="fieldset">
                <legend class="legend">
                    <span id="role-form-title"><?= $escaper->escapeHtml(__('Add a Role')) ?></span>
                </legend><br>

                <div class="field required">
                    <label class="label" for="role_name"><span><?= $escaper->escapeHtml(__('Role Name')) ?></span></label>
                    <div class="control">
                        <input type="text" name="role[role_name]" id="role_name" class="input-text form-input w-full"
                               data-validate="{required:true}">
                    </div>
                </div>

                <div class="field choice">
                    <input type="checkbox" name="role[is_default]" id="role_is_default" value="1" class="checkbox form-checkbox">
                    <label class="label" for="role_is_default">
                        <span><?= $escaper->escapeHtml(__('Give this role to members who have none of their own')) ?></span>
                    </label>
                </div>

                <?php foreach ($block->getGroupedPermissions() as $groupLabel => $groupPermissions): ?>
                    <div class="field permissions-group">
                        <span class="label"><span><?= $escaper->escapeHtml($groupLabel) ?></span></span>
                        <div class="control">
                            <?php foreach ($groupPermissions as $permission => $label): ?>
                                <div class="field choice">
                                    <input type="checkbox" name="role[permissions][]" class="checkbox permission form-checkbox"
                                           id="perm_<?= $escaper->escapeHtmlAttr($permission) ?>"
                                           value="<?= $escaper->escapeHtmlAttr($permission) ?>">
                                    <label class="label" for="perm_<?= $escaper->escapeHtmlAttr($permission) ?>">
                                        <span><?= $escaper->escapeHtml($label) ?></span>
                                    </label>
                                </div>
                            <?php endforeach; ?>
                        </div>
                    </div>
                <?php endforeach; ?>
            </fieldset>

            <div class="actions-toolbar">
                <div class="primary">
                    <button type="submit" class="action save primary btn btn-primary">
                        <span><?= $escaper->escapeHtml(__('Save Role')) ?></span>
                    </button>
                </div>
                <div class="secondary">
                    <button type="button" class="action clear btn btn-secondary" id="role-form-reset" style="display:none;">
                        <span><?= $escaper->escapeHtml(__('Cancel')) ?></span>
                    </button>
                    <a class="action back btn btn-secondary" href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>">
                        <span><?= $escaper->escapeHtml(__('Back')) ?></span>
                    </a>
                </div>
            </div>
        </form>

        <script type="text/javascript">
            (() => {
                'use strict';

                const roles = <?= /* @noEscape */ $block->getRolesJson() ?>;
                const form = document.getElementById('company-role-form');
                const title = document.getElementById('role-form-title');
                const cancel = document.getElementById('role-form-reset');

                function fill(role) {
                    document.getElementById('role_id').value = role ? role.role_id : '';
                    document.getElementById('role_name').value = role ? role.role_name : '';
                    document.getElementById('role_is_default').checked = !!(role && role.is_default);
                    form.querySelectorAll('input.permission').forEach((input) => {
                        input.checked = !!role && role.permissions.includes(input.value);
                    });
                    title.textContent = role ? '<?= $escaper->escapeJs(__('Edit Role')) ?>'
                                             : '<?= $escaper->escapeJs(__('Add a Role')) ?>';
                    cancel.style.display = role ? '' : 'none';
                }

                document.querySelectorAll('[data-role-edit]').forEach((button) => {
                    button.addEventListener('click', () => {
                        fill(roles[button.dataset.roleEdit]);
                        form.scrollIntoView({behavior: 'smooth'});
                    });
                });

                cancel.addEventListener('click', () => fill(null));
            })();
        </script>
    <?php endif; ?>
</div>
