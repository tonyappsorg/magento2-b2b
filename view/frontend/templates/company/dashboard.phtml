<?php
/**
 * Company dashboard.
 *
 * @var \Tonyapps\B2b\Block\Company\Dashboard $block
 * @var \Magento\Framework\Escaper $escaper
 */
$company = $block->getCompany();
if ($company === null) {
    return;
}
?>
<div class="block block-company">
    <?php if ($block->isPending()): ?>
        <div class="message info"><span><?= $escaper->escapeHtml(
            __('This company is waiting for approval. Until it is approved, company pricing does not apply.')
        ) ?></span></div>
    <?php endif; ?>

    <div class="block-title mb-6 text-2xl font-semibold">
        <strong><?= $escaper->escapeHtml($company->getName()) ?></strong>
    </div>

    <div class="block-content">
        <div class="box card mb-6">
            <strong class="box-title mb-4 block text-xl font-semibold">
                <span><?= $escaper->escapeHtml(__('Company Details')) ?></span>
            </strong>
            <div class="box-content">
                <dl class="grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
                    <div>
                        <dt class="text-sm text-gray-600"><?= $escaper->escapeHtml(__('Status')) ?></dt>
                        <dd class="mt-1 font-medium"><?= $escaper->escapeHtml($block->getStatusLabel()) ?></dd>
                    </div>

                    <?php if ($company->getData('legal_name')): ?>
                        <div>
                            <dt class="text-sm text-gray-600"><?= $escaper->escapeHtml(__('Legal Name')) ?></dt>
                            <dd class="mt-1 font-medium"><?= $escaper->escapeHtml($company->getData('legal_name')) ?></dd>
                        </div>
                    <?php endif; ?>

                    <?php if ($company->getData('vat_tax_id')): ?>
                        <div>
                            <dt class="text-sm text-gray-600"><?= $escaper->escapeHtml(__('VAT / Tax ID')) ?></dt>
                            <dd class="mt-1 font-medium"><?= $escaper->escapeHtml($company->getData('vat_tax_id')) ?></dd>
                        </div>
                    <?php endif; ?>

                    <?php if ($company->getData('email')): ?>
                        <div>
                            <dt class="text-sm text-gray-600"><?= $escaper->escapeHtml(__('Company Email')) ?></dt>
                            <dd class="mt-1 break-words font-medium"><?= $escaper->escapeHtml($company->getData('email')) ?></dd>
                        </div>
                    <?php endif; ?>

                    <?php if ($company->getData('telephone')): ?>
                        <div>
                            <dt class="text-sm text-gray-600"><?= $escaper->escapeHtml(__('Telephone')) ?></dt>
                            <dd class="mt-1 font-medium"><?= $escaper->escapeHtml($company->getData('telephone')) ?></dd>
                        </div>
                    <?php endif; ?>
                </dl>
            </div>
        </div>

        <?php $addressLines = $block->getAddressLines(); ?>
        <?php if ($addressLines): ?>
            <div class="box card mb-6">
                <strong class="box-title mb-4 block text-xl font-semibold">
                    <span><?= $escaper->escapeHtml(__('Legal Address')) ?></span>
                </strong>
                <div class="box-content">
                    <address class="space-y-1 not-italic">
                        <?php foreach ($addressLines as $line): ?>
                            <?= $escaper->escapeHtml($line) ?><br>
                        <?php endforeach; ?>
                    </address>
                </div>
            </div>
        <?php endif; ?>
    </div>

    <?php if ($block->canEditProfile() || $block->canViewUsers() || $block->canViewRoles()
              || $block->canViewChildren() || $block->canViewCompanyOrders()
              || $block->canViewCredit()): ?>
        <div class="company-actions mt-6 flex flex-wrap items-center gap-2">
                <?php if ($block->canEditProfile()): ?>
                    <a class="action edit primary btn btn-primary" href="<?= $escaper->escapeUrl($block->getEditUrl()) ?>">
                        <span><?= $escaper->escapeHtml(__('Edit Company Profile')) ?></span>
                    </a>
                <?php endif; ?>
                <?php if ($block->canViewUsers()): ?>
                    <a class="action users btn btn-secondary" href="<?= $escaper->escapeUrl($block->getUsersUrl()) ?>">
                        <span><?= $escaper->escapeHtml(__('Company Users')) ?></span>
                    </a>
                <?php endif; ?>
                <?php if ($block->canViewRoles()): ?>
                    <a class="action roles btn btn-secondary" href="<?= $escaper->escapeUrl($block->getRolesUrl()) ?>">
                        <span><?= $escaper->escapeHtml(__('Roles and Permissions')) ?></span>
                    </a>
                <?php endif; ?>
                <?php if ($block->canViewChildren()): ?>
                    <a class="action children btn btn-secondary" href="<?= $escaper->escapeUrl($block->getChildrenUrl()) ?>">
                        <span><?= $escaper->escapeHtml(__('Child Companies')) ?></span>
                    </a>
                <?php endif; ?>
                <?php if ($block->canViewCompanyOrders()): ?>
                    <a class="action orders btn btn-secondary" href="<?= $escaper->escapeUrl($block->getCompanyOrdersUrl()) ?>">
                        <span><?= $escaper->escapeHtml(__('Company Orders')) ?></span>
                    </a>
                <?php endif; ?>
                <?php if ($block->canViewCredit()): ?>
                    <a class="action credit btn btn-secondary" href="<?= $escaper->escapeUrl($block->getCreditUrl()) ?>">
                        <span><?= $escaper->escapeHtml(__('Store Credit')) ?></span>
                    </a>
                <?php endif; ?>
        </div>
    <?php endif; ?>
</div>
