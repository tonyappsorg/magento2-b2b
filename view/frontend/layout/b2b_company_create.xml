<?xml version="1.0"?>
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Tonyapps\B2b\Block\Company\Form" name="tonyapps_b2b.company.register" cacheable="false"
                   template="Tonyapps_B2b::company/form.phtml">
                <arguments>
                    <argument name="is_registration" xsi:type="boolean">true</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
